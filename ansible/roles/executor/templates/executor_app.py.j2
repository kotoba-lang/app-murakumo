import asyncio
import boto3
import contextlib
import json
import logging
import os
import shlex
import subprocess
import uuid
from pathlib import Path

from fastapi import FastAPI
from playwright.sync_api import sync_playwright


CONTROL_PLANE_URL = os.environ["EXECUTOR_CONTROL_PLANE_URL"]
WORKER_ID = os.environ["EXECUTOR_WORKER_ID"]
POLL_INTERVAL_SEC = int(os.environ.get("EXECUTOR_POLL_INTERVAL_SEC", "5"))
ARTIFACT_DIR = Path(os.environ.get("EXECUTOR_ARTIFACT_DIR", os.path.expanduser("~/.etzhayyim/executor-artifacts")))
R2_ENDPOINT_URL = os.environ.get("R2_ENDPOINT_URL", "")
R2_BUCKET = os.environ.get("R2_BUCKET", "")
R2_ACCESS_KEY_ID = os.environ.get("R2_ACCESS_KEY_ID", "")
R2_SECRET_ACCESS_KEY = os.environ.get("R2_SECRET_ACCESS_KEY", "")
R2_PUBLIC_BASE_URL = os.environ.get("R2_PUBLIC_BASE_URL", "")
LITELLM_BASE_URL = os.environ.get("LITELLM_BASE_URL", "http://127.0.0.1:4000")
LITELLM_API_KEY = os.environ.get("LITELLM_API_KEY", "")

app = FastAPI()
logger = logging.getLogger("etzhayyim.executor")
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")


@app.get("/health")
async def health():
    return {"ok": True, "workerId": WORKER_ID}


def upload_artifact(path: Path, content_type: str | None = None) -> dict | None:
    if not (R2_ENDPOINT_URL and R2_BUCKET and R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY):
        return None
    key = f"executor/{WORKER_ID}/{path.name}"
    client = boto3.client(
        "s3",
        endpoint_url=R2_ENDPOINT_URL,
        aws_access_key_id=R2_ACCESS_KEY_ID,
        aws_secret_access_key=R2_SECRET_ACCESS_KEY,
        region_name="auto",
    )
    extra_args = {}
    if content_type:
        extra_args["ContentType"] = content_type
    client.upload_file(str(path), R2_BUCKET, key, ExtraArgs=extra_args or None)
    public_url = f"{R2_PUBLIC_BASE_URL.rstrip('/')}/{key}" if R2_PUBLIC_BASE_URL else None
    return {
        "type": "r2",
        "bucket": R2_BUCKET,
        "key": key,
        "publicUrl": public_url,
    }


def run_browser_actions(page, actions: list[dict]) -> list[dict]:
    logs: list[dict] = []
    for index, action in enumerate(actions):
        kind = action.get("type", "").strip()
        selector = action.get("selector", "")
        timeout_ms = int(action.get("timeoutMs", 5000))
        entry = {"index": index, "type": kind}

        if kind == "goto":
            url = action.get("url", "")
            if not url:
                raise ValueError("browser action goto requires url")
            page.goto(url, wait_until=action.get("waitUntil", "domcontentloaded"), timeout=timeout_ms)
            entry["url"] = page.url
        elif kind == "click":
            if not selector:
                raise ValueError("browser action click requires selector")
            page.locator(selector).click(timeout=timeout_ms)
            entry["selector"] = selector
        elif kind == "fill":
            if not selector:
                raise ValueError("browser action fill requires selector")
            page.locator(selector).fill(action.get("value", ""), timeout=timeout_ms)
            entry["selector"] = selector
        elif kind == "select":
            if not selector:
                raise ValueError("browser action select requires selector")
            values = action.get("values")
            value = action.get("value")
            if values is not None:
                selected = page.locator(selector).select_option(values=values, timeout=timeout_ms)
            elif value is not None:
                selected = page.locator(selector).select_option(value=value, timeout=timeout_ms)
            else:
                raise ValueError("browser action select requires value or values")
            entry["selector"] = selector
            entry["selected"] = selected
        elif kind == "check":
            if not selector:
                raise ValueError("browser action check requires selector")
            checked = bool(action.get("checked", True))
            locator = page.locator(selector)
            if checked:
                locator.check(timeout=timeout_ms)
            else:
                locator.uncheck(timeout=timeout_ms)
            entry["selector"] = selector
            entry["checked"] = checked
        elif kind == "hover":
            if not selector:
                raise ValueError("browser action hover requires selector")
            page.locator(selector).hover(timeout=timeout_ms)
            entry["selector"] = selector
        elif kind == "press":
            if not selector:
                raise ValueError("browser action press requires selector")
            key = action.get("key", "Enter")
            page.locator(selector).press(key, timeout=timeout_ms)
            entry["selector"] = selector
            entry["key"] = key
        elif kind == "wait_for":
            target_url = action.get("url")
            state = action.get("state", "visible")
            if target_url:
                page.wait_for_url(target_url, timeout=timeout_ms)
                entry["url"] = page.url
            elif selector:
                page.locator(selector).wait_for(state=state, timeout=timeout_ms)
                entry["selector"] = selector
                entry["state"] = state
            else:
                wait_ms = int(action.get("durationMs", 1000))
                page.wait_for_timeout(wait_ms)
                entry["durationMs"] = wait_ms
        elif kind == "screenshot":
            path = action.get("path")
            if path:
                screenshot_path = Path(path)
            else:
                screenshot_path = ARTIFACT_DIR / f"{uuid.uuid4()}.png"
            screenshot_path.parent.mkdir(parents=True, exist_ok=True)
            if selector:
                page.locator(selector).screenshot(path=str(screenshot_path), timeout=timeout_ms)
                entry["selector"] = selector
            else:
                page.screenshot(path=str(screenshot_path), full_page=bool(action.get("fullPage", True)))
            entry["path"] = str(screenshot_path)
            uploaded = upload_artifact(screenshot_path, "image/png")
            if uploaded:
                entry["upload"] = uploaded
        elif kind == "extract_text":
            if not selector:
                raise ValueError("browser action extract_text requires selector")
            text = page.locator(selector).inner_text(timeout=timeout_ms)
            entry["selector"] = selector
            entry["text"] = text[:4000]
        elif kind == "evaluate":
            expression = action.get("expression", "").strip()
            if not expression:
                raise ValueError("browser action evaluate requires expression")
            result = page.evaluate(expression)
            entry["expression"] = expression[:200]
            entry["result"] = result
        elif kind == "download":
            if not selector:
                raise ValueError("browser action download requires selector")
            with page.expect_download(timeout=timeout_ms) as dl_info:
                page.locator(selector).click(timeout=timeout_ms)
            download = dl_info.value
            suggested = download.suggested_filename or f"{uuid.uuid4()}.bin"
            download_path = ARTIFACT_DIR / suggested
            download_path.parent.mkdir(parents=True, exist_ok=True)
            download.save_as(str(download_path))
            entry["selector"] = selector
            entry["path"] = str(download_path)
            entry["suggestedFilename"] = suggested
            uploaded = upload_artifact(download_path)
            if uploaded:
                entry["upload"] = uploaded
        else:
            raise ValueError(f"unsupported browser action type={kind}")

        logs.append(entry)
    return logs


def run_browser_task(task: str, requested: dict) -> dict:
    url = requested.get("url", task)
    actions = requested.get("actions", [])
    if not url and not actions:
        raise ValueError("browser_task requires url or task")
    timeout_ms = int(requested.get("timeoutMs", 15000))
    screenshot_name = f"{uuid.uuid4()}.png"
    screenshot_path = ARTIFACT_DIR / screenshot_name
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        try:
            page = browser.new_page(viewport={"width": 1440, "height": 960})
            if url:
                page.goto(url, wait_until="domcontentloaded", timeout=timeout_ms)
            with contextlib.suppress(Exception):
                page.wait_for_load_state("networkidle", timeout=min(timeout_ms, 5000))
            action_log = run_browser_actions(page, actions) if actions else []
            title = page.title()
            final_url = page.url
            text = page.locator("body").inner_text(timeout=3000)
            page.screenshot(path=str(screenshot_path), full_page=True)
        finally:
            browser.close()

    return {
        "workerId": WORKER_ID,
        "url": url,
        "finalUrl": final_url,
        "title": title,
        "textPreview": text[:4000],
        "screenshotPath": str(screenshot_path),
        "screenshotUpload": upload_artifact(screenshot_path, "image/png"),
        "actionLog": action_log,
    }


def capture_url_screenshot(url: str) -> dict | None:
    if not url:
        return None
    screenshot_path = ARTIFACT_DIR / f"{uuid.uuid4()}.png"
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        try:
            page = browser.new_page(viewport={"width": 1440, "height": 960})
            page.goto(url, wait_until="domcontentloaded", timeout=15000)
            with contextlib.suppress(Exception):
                page.wait_for_load_state("networkidle", timeout=5000)
            page.screenshot(path=str(screenshot_path), full_page=True)
        finally:
            browser.close()
    artifact = {"type": "screenshot", "path": str(screenshot_path), "status": "created", "url": url}
    uploaded = upload_artifact(screenshot_path, "image/png")
    if uploaded:
        artifact["upload"] = uploaded
    return artifact


def build_structured_output(instruction: str, summary: str, output_schema: dict, model: str) -> dict | None:
    try:
        from langchain_openai import ChatOpenAI
    except ImportError as exc:
        raise RuntimeError("langchain-openai is required for structured output") from exc

    llm = ChatOpenAI(
        model=model,
        base_url=f"{LITELLM_BASE_URL}/v1",
        api_key=LITELLM_API_KEY or "sk-local",
        temperature=0,
    )
    prompt = (
        "Return only valid JSON. "
        "Convert the browser task result into an object matching this schema.\n\n"
        f"Schema:\n{json.dumps(output_schema, ensure_ascii=False)}\n\n"
        f"Instruction:\n{instruction}\n\n"
        f"Summary:\n{summary}\n"
    )
    response = llm.invoke(prompt)
    content = getattr(response, "content", response)
    if isinstance(content, list):
        content = "".join(part.get("text", "") if isinstance(part, dict) else str(part) for part in content)
    if not isinstance(content, str):
        content = str(content)
    return json.loads(content)


def normalize_browser_use_result(
    instruction: str,
    model: str,
    raw_result,
    output_schema: dict | None = None,
    artifacts: list[dict] | None = None,
) -> dict:
    final_result = getattr(raw_result, "final_result", None)
    errors = getattr(raw_result, "errors", None)
    steps = getattr(raw_result, "all_results", None)
    final_url = getattr(raw_result, "final_url", None)

    if isinstance(raw_result, dict):
        final_result = final_result or raw_result.get("final_result") or raw_result.get("result")
        errors = errors or raw_result.get("errors")
        steps = steps or raw_result.get("all_results") or raw_result.get("steps")
        final_url = final_url or raw_result.get("final_url") or raw_result.get("url")

    step_count = len(steps) if isinstance(steps, list) else 0
    summary = final_result or f"browser-use completed for instruction: {instruction}"
    structured = None
    if output_schema:
        structured = build_structured_output(instruction, summary, output_schema, model)

    return {
        "workerId": WORKER_ID,
        "instruction": instruction,
        "model": model,
        "summary": summary,
        "stepsTaken": step_count,
        "finalUrl": final_url,
        "structured": structured,
        "artifacts": artifacts or [],
        "errors": errors or [],
        "raw": {
            "finalResult": final_result,
            "steps": steps,
        },
    }


def run_browser_use_task(task: str, requested: dict) -> dict:
    try:
        from browser_use import Agent
        from langchain_openai import ChatOpenAI
    except ImportError as exc:
        raise RuntimeError("browser-use dependencies are not installed") from exc

    model = requested.get("model", "gemma3-1b")
    max_steps = int(requested.get("maxSteps", 10))
    instruction = requested.get("instruction", task)
    if not instruction:
        raise ValueError("browser_use_task requires instruction or task")

    llm = ChatOpenAI(
        model=model,
        base_url=f"{LITELLM_BASE_URL}/v1",
        api_key=LITELLM_API_KEY or "sk-local",
        temperature=float(requested.get("temperature", 0)),
    )
    agent = Agent(task=instruction, llm=llm)
    result = asyncio.run(agent.run(max_steps=max_steps))
    final_url = getattr(result, "final_url", None)
    if final_url is None and isinstance(result, dict):
        final_url = result.get("final_url") or result.get("url")
    artifacts = []
    screenshot_artifact = capture_url_screenshot(final_url) if final_url else None
    if screenshot_artifact:
        artifacts.append(screenshot_artifact)

    return normalize_browser_use_result(
        instruction=instruction,
        model=model,
        raw_result=result,
        output_schema=requested.get("outputSchema"),
        artifacts=artifacts,
    )


def run_step(step_type: str, payload: dict) -> dict:
    task = payload.get("task", "idle")
    requested = payload.get("requestedPayload", {})
    if step_type == "executor_echo":
        return {"workerId": WORKER_ID, "echo": task, "payload": payload}
    if step_type == "shell_task":
        command = requested.get("command", f"printf %s {shlex.quote(task)}")
        completed = subprocess.run(
            command,
            shell=True,
            capture_output=True,
            text=True,
            timeout=int(requested.get("timeoutSec", 15)),
        )
        return {
            "workerId": WORKER_ID,
            "command": command,
            "exitCode": completed.returncode,
            "stdout": completed.stdout[-4000:],
            "stderr": completed.stderr[-4000:],
        }
    if step_type == "browser_task":
        return run_browser_task(task, requested)
    if step_type == "browser_use_task":
        return run_browser_use_task(task, requested)
    raise ValueError(f"unsupported step_type={step_type}")


def post_control_plane(path: str, payload: dict, timeout_sec: int = 10) -> dict:
    completed = subprocess.run(
        [
            "/usr/bin/curl",
            "-fsS",
            "-X",
            "POST",
            "-H",
            "Content-Type: application/json",
            "--max-time",
            str(timeout_sec),
            "-d",
            json.dumps(payload),
            f"{CONTROL_PLANE_URL}{path}",
        ],
        capture_output=True,
        text=True,
        check=True,
    )
    body = completed.stdout.strip()
    if not body:
        return {}
    return json.loads(body)


async def lease_loop():
    while True:
        try:
            response = await asyncio.to_thread(
                post_control_plane,
                "/leases/pull",
                {"workerId": WORKER_ID, "role": "executor"},
            )
            lease = response.get("lease")
            if lease:
                step_id = lease["step_id"]
                step_type = lease["step_type"]
                payload = lease.get("payload_json", {})
                await asyncio.to_thread(
                    post_control_plane,
                    "/leases/ack",
                    {"workerId": WORKER_ID, "stepId": step_id},
                )
                try:
                    result = await asyncio.to_thread(run_step, step_type, payload)
                    await asyncio.to_thread(
                        post_control_plane,
                        f"/steps/{step_id}/result",
                        {"workerId": WORKER_ID, "result": result, "status": "completed"},
                    )
                except Exception as exc:
                    logger.exception("step execution failed worker=%s step_id=%s step_type=%s", WORKER_ID, step_id, step_type)
                    await asyncio.to_thread(
                        post_control_plane,
                        f"/steps/{step_id}/result",
                        {
                            "workerId": WORKER_ID,
                            "error": {"message": str(exc), "stepType": step_type},
                            "status": "failed",
                        },
                    )
        except Exception:
            logger.exception("lease pull loop failed worker=%s", WORKER_ID)
        await asyncio.sleep(POLL_INTERVAL_SEC)


async def heartbeat_loop():
    while True:
        try:
            await asyncio.to_thread(
                post_control_plane,
                "/workers/heartbeat",
                {"workerId": WORKER_ID, "role": "executor"},
                5,
            )
        except Exception:
            logger.exception("heartbeat failed worker=%s", WORKER_ID)
        await asyncio.sleep(POLL_INTERVAL_SEC)


@app.on_event("startup")
async def startup():
    asyncio.create_task(heartbeat_loop())
    asyncio.create_task(lease_loop())
