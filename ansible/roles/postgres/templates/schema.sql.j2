CREATE TABLE IF NOT EXISTS job_run (
  job_id uuid PRIMARY KEY,
  workflow_type text NOT NULL,
  status text NOT NULL,
  input_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  context_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS job_step (
  step_id uuid PRIMARY KEY,
  job_id uuid NOT NULL REFERENCES job_run(job_id) ON DELETE CASCADE,
  step_key text NOT NULL,
  step_type text NOT NULL,
  status text NOT NULL,
  payload_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  result_json jsonb,
  error_json jsonb,
  attempt int NOT NULL DEFAULT 0,
  max_attempts int NOT NULL DEFAULT 3,
  dedupe_key text,
  lease_until timestamptz,
  worker_id text,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS worker_node (
  worker_id text PRIMARY KEY,
  role text NOT NULL,
  host text NOT NULL,
  ip inet,
  capabilities_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  models_json jsonb NOT NULL DEFAULT '[]'::jsonb,
  status text NOT NULL DEFAULT 'unknown',
  last_seen_at timestamptz NOT NULL DEFAULT now(),
  load_score numeric NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS job_event (
  event_id bigserial PRIMARY KEY,
  job_id uuid NOT NULL,
  step_id uuid,
  kind text NOT NULL,
  payload_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_job_step_job_id ON job_step(job_id);
CREATE INDEX IF NOT EXISTS idx_job_step_status ON job_step(status);
CREATE INDEX IF NOT EXISTS idx_worker_node_role ON worker_node(role);
