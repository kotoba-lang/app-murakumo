#!/bin/zsh
set -euo pipefail

exec env \
  OLLAMA_HOST=0.0.0.0:11434 \
  OLLAMA_FLASH_ATTENTION={{ ollama_flash_attention | default(1) }} \
  OLLAMA_KV_CACHE_TYPE={{ ollama_kv_cache_type | default('q8_0') }} \
  OLLAMA_NUM_PARALLEL={{ ollama_num_parallel | default(4) }} \
  OLLAMA_CONTEXT_LENGTH={{ ollama_context_length | default(16384) }} \
  {{ ollama_bin_path }} serve
